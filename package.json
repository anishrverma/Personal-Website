{
  "private": true,
  "name": "masterPortfolio",
  "version": "0.1.0",
  "homepage": ".",
  "scripts": {
    "build": "npm run lint && vite build",
    "predeploy": "npm run build",
    "deploy": "gh-pages -b gh-pages -d build",
    "dev": "vite",
    "lint": "eslint \"src/**/*.{js,jsx}\"",
    "preview": "vite preview",
    "prepare": "husky",
    "start": "vite",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "chart.js": "^2.9.3",
    "react": "^16.14.0",
    "react-bootstrap": "^1.6.8",
    "react-chartjs-2": "^2.11.2",
    "react-dom": "^16.14.0",
    "react-helmet": "^6.1.0",
    "react-reveal": "^1.2.2",
    "react-router-dom": "^5.3.4",
    "styled-components": "^5.3.11"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/react": "^16.14.8",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "gh-pages": "6.3.0",
    "globals": "17.8.0",
    "husky": "^9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "^17.3.0",
    "node-fetch": "^2.7.0",
    "prettier": "3.9.6",
    "sass": "^1.102.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "lint-staged": {
    "*.{js,css,md,json}": "prettier --write"
  }
}
