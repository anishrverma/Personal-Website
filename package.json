{
  "private": true,
  "name": "masterPortfolio",
  "version": "0.1.0",
  "homepage": ".",
  "scripts": {
    "build": "npm run lint && vite build",
    "predeploy": "npm run build",
    "deploy": "gh-pages -b gh-pages -d build",
    "dev": "vite",
    "lint": "eslint \"src/**/*.{js,jsx}\"",
    "preview": "vite preview",
    "start": "vite",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@apollo/react-hooks": "^3.1.3",
    "apollo-boost": "^0.4.4",
    "baseui": "^9.116.3",
    "chart.js": "^2.9.3",
    "graphql": "^14.5.8",
    "react": "^16.14.0",
    "react-bootstrap": "^1.6.8",
    "react-chartjs-2": "^2.11.2",
    "react-dom": "^16.14.0",
    "react-helmet": "^6.1.0",
    "react-reveal": "^1.2.2",
    "react-router-dom": "^5.3.4",
    "styled-components": "^5.3.11",
    "styletron-engine-atomic": "^1.6.2",
    "styletron-react": "^5.2.7"
  },
  "devDependencies": {
    "@types/react": "^16.14.8",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "8.57.1",
    "eslint-config-react-app": "7.0.1",
    "gh-pages": "6.3.0",
    "husky": "^4.2.5",
    "jsdom": "30.0.1",
    "lint-staged": "^10.2.11",
    "node-fetch": "^2.7.0",
    "prettier": "2.0.5",
    "prettier-package-json": "^2.8.0",
    "sass": "^1.102.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "eslintIgnore": [
    "src/assests/font-awesome/js/"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.json": "prettier-package-json --write",
    "*.{js,css,md}": "prettier --write"
  }
}
